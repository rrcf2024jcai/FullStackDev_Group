{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "types": ["node"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "allowJs": true
  },
  "include": ["src/**/*", "prisma.config.ts"]
}