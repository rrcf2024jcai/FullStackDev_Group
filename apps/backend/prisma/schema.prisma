generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

model Employee {
  id            Int            @id @default(autoincrement())
  firstName     String
  lastName      String
  role          String
  department    String
  clockRecords  Attendance[]
  leaveRequests LeaveRequest[]
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  clockIn     DateTime?
  clockOut    DateTime?
  locationIn  String?
  locationOut String?
}

model LeaveRequest {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  startDate   DateTime
  endDate     DateTime
  type        String   
  reason      String
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id])
}
